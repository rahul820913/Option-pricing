        "APPROACHES = [\"Approach I\", \"Approach II\", \"Approach III\"]\n",
        "\n",
        "def standardize(X_train, X_other):\n",
        "    mean = X_train.mean(axis=0, keepdims=True)\n",
        "    std = X_train.std(axis=0, keepdims=True)\n",
        "    std[std < 1e-8] = 1e-8\n",
        "    return (X_train - mean) / std, (X_other - mean) / std, mean, std\n",
        "\n",
        "def split_val(X, y, frac=0.1, seed=42):\n",
        "    rng = np.random.RandomState(seed)\n",
        "    idx = rng.permutation(X.shape[0])\n",
        "    n_val = max(1, int(X.shape[0] * frac))\n",
        "    return X[idx[n_val:]], y[idx[n_val:]], X[idx[:n_val]], y[idx[:n_val]]\n",
        "\n",
        "def em_metric(actual, pred, bin_width=BIN_WIDTH):\n",
        "    return bin_width * np.mean(np.abs(actual - pred))\n",
        "\n",
        "def rho_metric(actual, pred):\n",
        "    return np.mean(np.abs(actual - pred) > 2)"
