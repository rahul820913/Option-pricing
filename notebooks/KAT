        "def train_with_early_stopping(X_tr_raw, y_tr, X_val_raw, y_val, width,\n",
        "                               chunk_steps=5, max_steps=8000, patience=5,\n",
        "                               lr=5e-3, lamb=1e-4, seed=42, verbose=True):\n",
        "    X_tr, X_val, mean, std = standardize(X_tr_raw, X_val_raw)\n",
        "\n",
        "    dataset = {\n",
        "        \"train_input\": torch.tensor(X_tr, dtype=torch.float32).to(device),\n",
        "        \"train_label\": torch.tensor(y_tr - 1, dtype=torch.long).to(device),\n",
        "        \"test_input\":  torch.tensor(X_val, dtype=torch.float32).to(device),\n",
        "        \"test_label\":  torch.tensor(y_val - 1, dtype=torch.long).to(device),\n",
        "    }\n",
        "\n",
        "    model = PyKAN(width=width, grid=5, k=3, seed=seed, device=device)\n",
        "    model.saveckpt = lambda *args, **kwargs: None\n",
        "    loss_fn = torch.nn.CrossEntropyLoss()\n",
        "\n",
        "    best_val_loss, best_state, patience_counter = float(\"inf\"), None, 0\n",
        "\n",
        "    for i in range(max_steps // chunk_steps):\n",
        "        model.fit(dataset, opt=\"Adam\", lr=lr, steps=chunk_steps, lamb=lamb,\n",
        "                  loss_fn=loss_fn, update_grid=(i < 3))\n",
        "\n",
        "        with torch.no_grad():\n",
        "            val_loss = loss_fn(model(dataset[\"test_input\"]), dataset[\"test_label\"]).item()\n",
        "        if verbose:\n",
        "            print(f\"    step {(i+1)*chunk_steps:3d}  val_loss = {val_loss:.4f}\")\n",
        "\n",
        "        if val_loss < best_val_loss - 1e-4:\n",
        "            best_val_loss, best_state, patience_counter = val_loss, copy.deepcopy(model.state_dict()), 0\n",
        "        else:\n",
        "            patience_counter += 1\n",
        "            if patience_counter >= patience:\n",
        "                if verbose:\n",
        "                    print(f\"    early stopped at step {(i+1)*chunk_steps}\")\n",
        "                break\n",
        "\n",
        "    if best_state is not None:\n",
        "        model.load_state_dict(best_state)\n",
        "    return model, mean, std\n",
        "\n",
        "\n",
        "@torch.no_grad()\n",
        "def evaluate_pykan(model, mean, std, X_test_raw, y_test):\n",
        "    X_test = (X_test_raw - mean) / std\n",
        "    X_t = torch.tensor(X_test, dtype=torch.float32).to(device)\n",
        "    pred_bins = torch.argmax(model(X_t), dim=1).cpu().numpy() + 1\n",
        "    return em_metric(y_test, pred_bins), rho_metric(y_test, pred_bins)"
