        "mu_O = lr_open.mean(axis=1)\n",
        "mu_H = lr_high.mean(axis=1)\n",
        "mu_L = lr_low.mean(axis=1)\n",
        "mu_C = lr_close.mean(axis=1)\n",
        "\n",
        "stack = np.stack([lr_open, lr_high, lr_low, lr_close], axis=1)\n",
        "centered = stack - stack.mean(axis=2, keepdims=True)\n",
        "cov = np.einsum('nik,njk->nij', centered, centered) / (stack.shape[2] - 1)\n",
        "\n",
        "def signed_sqrt(x):\n",
        "  out = np.zeros_like(x)\n",
        "  mask = x != 0\n",
        "  out[mask] = x[mask] / np.sqrt(np.abs(x[mask]))\n",
        "  return out\n",
        "\n",
        "cov_transformed = signed_sqrt(cov)\n",
        "\n",
        "idx_pairs = [(i, j) for i in range(4) for j in range(i+1)]\n",
        "labels = ['O', 'H', 'L', 'C']\n",
        "cov_cols = {f'cov_{labels[i]}{labels[j]}': cov_transformed[:, i, j] for i, j in idx_pairs}\n",
        "\n",
        "approach2 = pd.DataFrame({'mu_O': mu_O, 'mu_H': mu_H, 'mu_L': mu_L, 'mu_C': mu_C, **cov_cols}, index=opt.index)\n",
