        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "from torch.utils.data import TensorDataset, DataLoader\n",
        "\n",
        "BIN_WIDTH = 0.1\n",
        "LABEL_COL = \"bin_label\"\n",
        "\n",
        "def prepare_data(feature_df):\n",
        "    feature_cols = [c for c in feature_df.columns if c != LABEL_COL]\n",
        "\n",
        "    X_train_raw = feature_df.loc[train_mask, feature_cols].values.astype(np.float32)\n",
        "    X_test_raw  = feature_df.loc[test_mask,  feature_cols].values.astype(np.float32)\n",
        "    y_train_raw = feature_df.loc[train_mask, LABEL_COL].values.astype(np.int64)\n",
        "    y_test_raw  = feature_df.loc[test_mask,  LABEL_COL].values.astype(np.int64)\n",
        "\n",
        "    mu, sigma = X_train_raw.mean(axis=0), X_train_raw.std(axis=0) + 1e-8\n",
        "    X_train = (X_train_raw - mu) / sigma\n",
        "    X_test  = (X_test_raw  - mu) / sigma\n",
        "\n",
        "    train_classes = np.sort(np.unique(y_train_raw))\n",
        "    num_classes = len(train_classes)\n",
        "\n",
        "    def map_labels(y):\n",
        "        idx = np.searchsorted(train_classes, y)\n",
        "        return np.clip(idx, 0, num_classes - 1)\n",
        "\n",
        "    y_train = map_labels(y_train_raw)\n",
        "    y_test  = map_labels(y_test_raw)\n",
        "\n",
        "    return X_train, X_test, y_train, y_test, len(feature_cols), num_classes\n",
        "\n",
        "\n",
        "def train_and_evaluate(feature_df, name, epochs=40, embed_dim=64, depth=4, num_heads=4, lr=1.2e-4, batch_size=32):\n",
        "    X_train, X_test, y_train, y_test, n_features, num_classes = prepare_data(feature_df)\n",
        "\n",
        "    train_loader = DataLoader(TensorDataset(torch.tensor(X_train), torch.tensor(y_train)),\n",
        "                               batch_size=batch_size, shuffle=True)\n",
        "    test_loader  = DataLoader(TensorDataset(torch.tensor(X_test), torch.tensor(y_test)),\n",
        "                               batch_size=256, shuffle=False)\n",
        "\n",
        "    model = KATTabularTransformer(\n",
        "        n_features=n_features,\n",
        "        num_classes=num_classes,\n",
        "        embed_dim=embed_dim,\n",
        "        depth=depth,\n",
        "        num_heads=num_heads,\n",
        "    ).to(device)\n",
        "\n",
        "    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n",
        "    criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "    print(f\"\\n=== Training {name} | n_features={n_features}, num_classes={num_classes} ===\")\n",
        "    for epoch in range(1, epochs + 1):\n",
        "        model.train()\n",
        "        total_loss = 0.0\n",
        "        for xb, yb in train_loader:\n",
        "            xb, yb = xb.to(device), yb.to(device)\n",
        "            optimizer.zero_grad()\n",
        "            loss = criterion(model(xb), yb)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "            total_loss += loss.item() * xb.size(0)\n",
        "        if epoch % 10 == 0 or epoch == 1 or epoch == epochs:\n",
        "            print(f\"  epoch {epoch:3d} | train loss {total_loss/len(train_loader.dataset):.4f}\")\n",
        "\n",
        "    model.eval()\n",
        "    all_preds, all_true = [], []\n",
        "    with torch.no_grad():\n",
        "        for xb, yb in test_loader:\n",
        "            preds = model(xb.to(device)).argmax(dim=1).cpu().numpy()\n",
        "            all_preds.append(preds)\n",
        "            all_true.append(yb.numpy())\n",
        "    P = np.concatenate(all_preds)\n",
        "    C = np.concatenate(all_true)\n",
        "\n",
        "    EM = BIN_WIDTH * np.mean(np.abs(C - P))\n",
        "    rho = np.mean(np.abs(C - P) > 2)\n",
        "    print(f\"  -> {name}: EM={EM:.4f}, rho={rho:.4f}\")\n",
        "\n",
        "    return model, {\"approach\": name, \"EM\": EM, \"rho\": rho, \"n_features\": n_features}"
      ],
