        "    y_train_full = feature_df.loc[train_mask, LABEL_COL].values.astype(np.int64)\n",
        "    y_test_raw   = feature_df.loc[test_mask,  LABEL_COL].values.astype(np.int64)\n",
        "\n",
        "    # Same chronological val split as the KAT-Transformer prep, for a fair comparison\n",
        "    n_val = int(len(X_train_full) * val_frac)\n",
        "    n_train = len(X_train_full) - n_val\n",
        "    X_tr_raw, X_val_raw = X_train_full[:n_train], X_train_full[n_train:]\n",
        "    y_tr_raw, y_val_raw = y_train_full[:n_train], y_train_full[n_train:]\n",
        "\n",
        "    train_classes = np.sort(np.unique(y_tr_raw))\n",
        "    num_classes = len(train_classes)\n",
        "\n",
        "    def map_labels_1indexed(y):\n",
        "        idx = np.searchsorted(train_classes, y)\n",
        "        idx = np.clip(idx, 0, num_classes - 1)\n",
        "        return idx + 1   # 1-indexed, since train_with_early_stopping does y - 1 internally\n",
