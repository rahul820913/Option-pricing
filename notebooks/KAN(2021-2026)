    'Change in OI': 'CHG_IN_OI'\n","        }\n","        options_df = options_df.rename(columns=rename_map)\n","    else:\n","        if 'TIMESTAMP' in options_df.columns:\n","            options_df = options_df.rename(columns={'TIMESTAMP': 'Date'})\n","\n","    # This scrubs commas and dashes out of financial columns and forces them to floats\n","    numeric_cols = ['CONTRACTS', 'STRIKE_PR', 'CLOSE', 'OPEN', 'HIGH', 'LOW']\n","    for col in numeric_cols:\n","        if col in options_df.columns:\n","            options_df[col] = options_df[col].astype(str).str.replace(',', '', regex=False)\n","            options_df[col] = options_df[col].str.replace('-', '0', regex=False)\n","            options_df[col] = pd.to_numeric(options_df[col], errors='coerce')\n","\n","    bond_df = bond_df.rename(columns={'Price': 'Bond_Yield'})\n","\n","    underlying_df = underlying_df.rename(columns={\n","        'Open': 'Open_spot', 'High': 'High_spot',\n","        'Low': 'Low_spot', 'Close': 'Close_spot'\n","    })\n","\n","    # Also clean the spot prices just to be safe\n","    spot_numeric_cols = ['Open_spot', 'High_spot', 'Low_spot', 'Close_spot']\n","    for col in spot_numeric_cols:\n","        if col in underlying_df.columns:\n","            underlying_df[col] = underlying_df[col].astype(str).str.replace(',', '', regex=False)\n","            underlying_df[col] = underlying_df[col].str.replace('-', '0', regex=False)\n","            underlying_df[col] = pd.to_numeric(underlying_df[col], errors='coerce')\n","\n","    return options_df, underlying_df, bond_df\n","\n","\n","def parse_dates(options_df: pd.DataFrame, underlying_df: pd.DataFrame, bond_df: pd.DataFrame):\n","    options_df['Date'] = pd.to_datetime(options_df['Date'])\n","    options_df['EXPIRY_DT'] = pd.to_datetime(options_df['EXPIRY_DT'])\n","\n","    underlying_df['Date'] = pd.to_datetime(underlying_df['Date'])\n","    bond_df['Date'] = pd.to_datetime(bond_df['Date'], dayfirst=True)\n","\n","    return options_df, underlying_df, bond_df\n","\n","def preprocess_options(options_df: pd.DataFrame) -> pd.DataFrame:\n","    # Filter CE and traded contracts\n","    df = options_df[(options_df['OPTION_TYP'] == 'CE') & (options_df['CONTRACTS'] > 0)].copy()\n","\n","    # Sort and calculate previous close\n","    df = df.sort_values(by=['SYMBOL', 'STRIKE_PR', 'EXPIRY_DT', 'Date'])\n","    df['Prev_Close'] = df.groupby(['SYMBOL', 'STRIKE_PR', 'EXPIRY_DT'])['CLOSE'].shift(1)\n","    df['Prev_Close'] = df['Prev_Close'].fillna(0)\n","\n","    # Remove rows without a valid previous close\n","    return df[df['Prev_Close'] != 0]\n","\n","\n","def preprocess_underlying(underlying_df: pd.DataFrame) -> pd.DataFrame:\n","    df = underlying_df.sort_values(by='Date')\n","\n","    # Use a dictionary to build lag columns efficiently\n","    lag_cols = {}\n","\n","    for col in ['Open_spot', 'High_spot', 'Low_spot', 'Close_spot']:\n","        for i in range(1, 21):\n","            lag_cols[f'Underlying_{col}_Lag_{i}'] = df[col].shift(i)\n","\n","    lag_df = pd.DataFrame(lag_cols, index=df.index)\n","    return pd.concat([df, lag_df], axis=1)\n","\n","\n","def merge_and_filter(options_df: pd.DataFrame, underlying_df: pd.DataFrame, bond_df: pd.DataFrame) -> pd.DataFrame:\n","    # Merge datasets cleanly\n","    df = pd.merge(options_df, underlying_df, on='Date', how='inner')\n","    df = pd.merge(df, bond_df[['Date', 'Bond_Yield']], on='Date', how='left')\n","\n","    # 1. Moneyness Filter (Near-ATM: <= 4% difference)\n","    df['Moneyness_Diff'] = (1 - (df['Close_spot'] / df['STRIKE_PR'])).abs()\n","    df = df[df['Moneyness_Diff'] <= 0.04]\n","\n","    # 2. Time to Maturity (TTM) Filter (3 to 45 days)\n","    df['TTM'] = (df['EXPIRY_DT'] - df['Date']).dt.days\n","    df = df[(df['TTM'] >= 3) & (df['TTM'] <= 45)]\n","\n","    # 3. Clean up ghost columns\n","    df = df.loc[:, ~df.columns.str.contains('^Unnamed')]\n","\n","    # 4. Drop remaining NaNs\n","    return df.dropna().reset_index(drop=True)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"zc7ZuaKjhLEl"},"outputs":[],"source":["def generate_target_bins(df: pd.DataFrame) -> pd.Series:\n","    ratio = (df['CLOSE'] / df['STRIKE_PR']) * 100\n","    bins = np.floor((ratio - 1e-9) / BIN_WIDTH).astype(int) + 1\n","    return np.clip(bins, 1, NUM_CLASSES)\n","\n","def get_log_returns(df: pd.DataFrame, col_base: str) -> np.ndarray:\n","    cols = [col_base] + [f'Underlying_{col_base}_Lag_{i}' for i in range(1, 20)]\n","    prices = df[cols].values\n","\n","    # Calculate log returns: ln(P_t / P_{t-1})\n","    return np.log(prices[:, :-1] / prices[:, 1:])\n","\n","\n","def extract_approach_1(df: pd.DataFrame) -> pd.DataFrame:\n","    lr_close = get_log_returns(df, 'Close_spot')\n","    lr_sorted = np.sort(lr_close, axis=1)\n","\n","    app1_df = pd.DataFrame(\n","        lr_sorted,\n","        columns=[f'LR_Order_Stat_{i}' for i in range(1, 20)],\n","        index=df.index\n","    )\n","\n","    app1_df['Interest_Rate'] = df['Bond_Yield']\n","    app1_df['TTM'] = df['TTM'] / 365.0\n","    app1_df['Moneyness'] = df['Close_spot'] / df['STRIKE_PR']\n","\n","    return app1_df\n","\n","\n","def extract_approach_2(df: pd.DataFrame) -> pd.DataFrame:\n","    # Target all specific '_spot' columns\n","    lr_O = get_log_returns(df, 'Open_spot')\n","    lr_H = get_log_returns(df, 'High_spot')\n","    lr_L = get_log_returns(df, 'Low_spot')\n","    lr_C = get_log_returns(df, 'Close_spot')\n","\n","    app2_df = pd.DataFrame(index=df.index)\n","    app2_df['Mean_LR_Open'] = lr_O.mean(axis=1)\n","    app2_df['Mean_LR_High'] = lr_H.mean(axis=1)\n","    app2_df['Mean_LR_Low'] = lr_L.mean(axis=1)\n","    app2_df['Mean_LR_Close'] = lr_C.mean(axis=1)\n","\n","    # Vectorized Covariance matrix calculation\n","    lr_stack = np.stack([lr_O, lr_H, lr_L, lr_C], axis=1)\n","    lr_centered = lr_stack - lr_stack.mean(axis=2, keepdims=True)\n","    cov = np.einsum('nij,nkj->nik', lr_centered, lr_centered) / 18\n","    cov_stats = np.sign(cov) * np.sqrt(np.abs(cov))\n","\n","    pairs = [(0,0), (0,1), (0,2), (0,3), (1,1), (1,2), (1,3), (2,2), (2,3), (3,3)]\n","    labels = ['OO', 'OH', 'OL', 'OC', 'HH', 'HL', 'HC', 'LL', 'LC', 'CC']\n","\n","    for (i, j), label in zip(pairs, labels):\n","        app2_df[f'Cov_Stat_{label}'] = cov_stats[:, i, j]\n","\n","    app2_df['Interest_Rate'] = df['Bond_Yield']\n","    app2_df['TTM'] = df['TTM'] / 365.0\n","    app2_df['Moneyness'] = df['Close_spot'] / df['STRIKE_PR']\n","\n","    return app2_df\n","\n","\n","def extract_approach_3(df: pd.DataFrame) -> pd.DataFrame:\n","    app3_df = extract_approach_2(df)\n","\n","    ttm_col = app3_df.pop('TTM')\n","    money_col = app3_df.pop('Moneyness')\n","\n","    app3_df['Scaled_Prev_Price'] = df['Prev_Close'] / df['STRIKE_PR']\n","\n","    # Explicitly target the renamed spot columns for the lag calculations\n","    cols_C = ['Close_spot'] + [f'Underlying_Close_spot_Lag_{i}' for i in range(1, 20)]\n","    prices_C = df[cols_C].values\n","    app3_df['Mean_Moneyness'] = prices_C.mean(axis=1) / df['STRIKE_PR']\n","\n","    app3_df['TTM'] = ttm_col\n","    app3_df['Moneyness'] = money_col\n","\n","    return app3_df"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"HFLC5IGVhOCd"},"outputs":[],"source":["def process_dataset(options_clean, spot_clean, bond_clean, approach='Approach III', is_covid=False):\n","    df = merge_and_filter(options_clean, spot_clean, bond_clean)\n","\n","    if df.empty:\n","        raise ValueError(\"Dataframe is empty after filter operations.\")\n","\n","    ratio_check = 100.0 * df['CLOSE'] / df['STRIKE_PR']\n","    df = df[ratio_check <= RATIO_CAP].copy()\n","\n","    df = df.sort_values(by='Date').reset_index(drop=True)\n","\n","    if is_covid:\n","        train_df = pd.DataFrame(columns=df.columns)\n","        test_df = df.copy()\n","    else:\n","        train_mask = (df['Date'] >= '2015-01-01') & (df['Date'] <= '2017-09-30')\n","        test_mask = (df['Date'] >= '2017-10-01') & (df['Date'] <= '2018-12-31')\n","\n","        train_df = df[train_mask].copy()\n","        test_df = df[test_mask].copy()\n","\n","        if train_df.empty or test_df.empty:\n","            raise ValueError(\"Train or Test dataframe is empty after applying date masks.\")\n","\n","    # FIX: both train and test targets are now bin labels (classification, not regression)\n","    y_train_bins = generate_target_bins(train_df).values if not train_df.empty else np.array([])\n","    y_test_bins = generate_target_bins(test_df).values\n","\n","    extractor_map = {\n","        'Approach I': extract_approach_1,\n","        'Approach II': extract_approach_2,\n","        'Approach III': extract_approach_3\n","    }\n","\n","    X_train_raw = extractor_map[approach](train_df).values if not train_df.empty else np.array([])\n","    X_test_raw = extractor_map[approach](test_df).values\n","\n","    return X_train_raw, y_train_bins, X_test_raw, y_test_bins"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"iP0Ssw6LYQeH"},"outputs":[],"source":["def error_metric_EM(actual_bins, predicted_bins, bin_width=0.1):\n","    return bin_width * np.mean(np.abs(actual_bins - predicted_bins))\n","\n","def inaccuracy_rho(actual_bins, predicted_bins):\n","    return np.mean(np.abs(actual_bins - predicted_bins) > 2)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":18093,"status":"ok","timestamp":1787156110720,"user":{"displayName":"Tiru","userId":"06263477309948348981"},"user_tz":-330},"id":"4oOasOQNhXni","outputId":"7742c306-2e7d-4e6b-8ff8-ff967ce1c235"},"outputs":[{"output_type":"stream","name":"stdout","text":["Executing on device: cuda\n","Loading Standard NIFTY Data...\n"]},{"output_type":"stream","name":"stderr","text":["/tmp/ipykernel_802/3988781040.py:59: UserWarning: Could not infer format, so each element will be parsed individually, falling back to `dateutil`. To ens