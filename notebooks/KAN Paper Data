width=width, grid=5, k=3, seed=seed, device=device)\n","    model.saveckpt = lambda *args, **kwargs: None\n","    loss_fn = torch.nn.CrossEntropyLoss()\n","\n","    best_val_loss, best_state, patience_counter = float(\"inf\"), None, 0\n","\n","    for i in range(max_steps // chunk_steps):\n","        model.fit(dataset, opt=\"Adam\", lr=lr, steps=chunk_steps, lamb=lamb,\n","                  loss_fn=loss_fn, update_grid=(i < 3))\n","\n","        with torch.no_grad():\n","            val_loss = loss_fn(model(dataset[\"test_input\"]), dataset[\"test_label\"]).item()\n","        if verbose:\n","            print(f\"    step {(i+1)*chunk_steps:3d}  val_loss = {val_loss:.4f}\")\n","\n","        if val_loss < best_val_loss - 1e-4:\n","            best_val_loss, best_state, patience_counter = val_loss, copy.deepcopy(model.state_dict()), 0\n","        else:\n","            patience_counter += 1\n","            if patience_counter >= patience:\n","                if verbose:\n","                    print(f\"    early stopped at step {(i+1)*chunk_steps}\")\n","                break\n","\n","    if best_state is not None:\n","        model.load_state_dict(best_state)\n","    return model, mean, std\n","\n","@torch.no_grad()\n","def evaluate(model, mean, std, X_test_raw, y_test):\n","    X_test = (X_test_raw - mean) / std\n","    X_t = torch.tensor(X_test, dtype=torch.float32).to(device)\n","    pred_bins = torch.argmax(model(X_t), dim=1).cpu().numpy() + 1\n","    return em_metric(y_test, pred_bins), rho_metric(y_test, pred_bins)"],"metadata":{"id":"szRlNS8KQRK-","executionInfo":{"status":"ok","timestamp":1787469643636,"user_tz":-330,"elapsed":1,"user":{"displayName":"Tiru","userId":"06263477309948348981"}}},"execution_count":67,"outputs":[]},{"cell_type":"code","source":["approach_dfs = {\n","    \"Approach I\": approach1,\n","    \"Approach II\": approach2,\n","    \"Approach III\": approach3,\n","}\n","\n","results = {}\n","models = {}\n","\n","for name, df in approach_dfs.it