5, 22), test (31873, 22)\n","Approach II: train (53965, 17), test (31873, 17)\n","Approach III: train (53965, 19), test (31873, 19)\n","y_tr (continuous) shape: (53965,)\n","y_te_bins shape: (31873,)\n"]}],"source":["MONOTONIC_ORDER = {\n","    'Approach I':   ['moneyness', 'time_to_maturity'],\n","    'Approach II':  ['moneyness', 'time_to_maturity'],\n","    'Approach III': ['moneyness', 'time_to_maturity', 'mean_moneyness', 'prev_option_price_scaled'],\n","}\n","\n","def build_dinn_matrix(feature_df, approach_name):\n","    mono_cols = MONOTONIC_ORDER[approach_name]\n","    free_cols = [c for c in feature_df.columns if c not in mono_cols + ['bin_label']]\n","    ordered_cols = free_cols + mono_cols\n","    return feature_df[ordered_cols].values\n","\n","approach_dfs = {'Approach I': approach1, 'Approach II': approach2, 'Approach III': approach3}\n","\n","X_tr_dict, X_te_dict = {}, {}\n","for app_name, df in approach_dfs.items():\n","    X_full = build_dinn_matrix(df, app_name)\n","    X_tr_dict[app_name] = X_full[train_mask.values]\n","    X_te_dict[app_name] = X_full[test_mask.values]\n","    print(f\"{app_name}: train {X_tr_dict[app_name].shape}, test {X_te_dict[app_name].shape}\")\n","\n","\n","y_tr = opt.loc[train_mask.values, 'output_ratio'].values\n","y_te_bins = np.clip(opt.loc[test_mask.values, 'bin_label'].values, 1, NUM_CLASSES)\n","\n","print(\"y_tr (continuous) shape:\", y_tr.shape)\n","print(\"y_te_bins shape:\", y_te_bins.shape)"]},{"cell_type":"code","execution_count":105,"metadata":{"executionInfo":{"elapsed":52,"status":"ok","timestamp":1785689038416,"user":{"displayName":"Rahul","userId":"09331106873525786177"},"user_tz":-330},"id":"ZFzo2KEZ53Hv"},"outputs":[],"source":["import tensorflow as tf\n","from tensorflow.keras.layers import Input, Dense, Add, Layer\n","from tensorflow.keras.models import Model\n","from tensorflow.keras.constraints import NonNeg\n","from tensorflow.keras.optimizers import Adam\n","from tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau\n","from sklearn.preprocessing import MinMaxScaler, RobustScaler\n","import numpy as np\n","from tensorflow.keras.regularizers import l2\n","from tensorflow.keras.layers import Dropout\n","\n","def split_and_scale_dinn_features(X_matrix, approach='Approach III', scaler_mon=None, scaler_unc=None, is_training=True):\n","    num_mon = 4 if approach == 'Approach III' else 2\n","\n","    X_unc = X_matrix[:, :-num_mon]\n","    X_mon = X_matrix[:, -num_mon:].copy()\n","\n","    if is_training:\n","        scaler_mon = MinMaxScaler(feature_range=(0, 1))\n","        scaler_unc = RobustScaler()\n","        X_mon_scaled = scaler_mon.fit_transform(X_mon)\n","        X_unc_scaled = scaler_unc.fit_transform(X_unc)\n","        return X_mon_scaled, X_unc_scaled, scaler_mon, scaler_unc\n","    else:\n","        X_mon_scaled = scaler_mon.transform(X_mon)\n","        X_unc_scaled = scaler_unc.transform(X_unc)\n","        X_mon_scaled = np.clip(X_mon_scaled, 0, 1.5)\n","        X_unc_scaled = np.clip(X_unc_scaled, -5.0, 5.0)\n","        return X_mon_scaled, X_unc_scaled\n","\n","\n","def build_dinn_softmax_model(X_mon_dim, X_unc_dim, num_classes):\n","    input_mon = Input(shape=(X_mon_dim,), name='monotonic_input')\n","    input_unc = Input(shape=(X_unc_dim,), name='unconstrained_input')\n","\n","    mon_dense1 = Dense(32, activation='relu', kernel_constraint=NonNeg())(input_mon)\n","    mon_dense2 = Dense(16, activation='relu', kernel_constraint=NonNeg())(mon_dense1)\n","    mon_out = Dense(8, activation='relu', kernel_constraint=NonNeg())(mon_dense2)\n","\n","    # unconstrained branch: unchanged\n","    x_unc = Dense(64, activation='relu', kernel_regularizer=l2(1e-4))(input_unc)\n","    x_unc = Dropout(0.3)(x_unc)\n","    x_unc = Dense(32, activation='relu', kernel_regularizer=l2(1e-4))(x_unc)\n","    x_unc = Dropout(0.3)(x_unc)\n","\n","    combined = tf.keras.layers.Concatenate()([mon_out, x_unc])\n","    combined = Dense(64, activation='relu')(combined)\n","    output = Dense(num_classes, activation='softmax')(combined)\n","\n","    model = Model(inputs=[input_mon, input_unc], outputs=output)\n","    model.compile(optimizer=Adam(learning_rate=3e-4, clipnorm=1.0),\n","                  loss='sparse_categorical_crossentropy',\n","                  metrics=['accuracy'])\n","    return model\n","\n","\n","def train_dinn_softmax_model(X_train_matrix, y_train_bins, approach='Approach III',\n","                              num_classes=None, epochs=100, batch_size=32):\n","    X_mon, X_unc, scaler_mon, scaler_unc = split_and_scale_dinn_features(\n","        X_train_matrix, approach, is_training=True\n","    )\n","\n","    model = build_dinn_softmax_model(X_mon.shape[1], X_unc.shape[1], num_classes)\n","\n","    es = EarlyStopping(monitor='val_loss', patience=8, restore_best_weights=True)\n","    reduce_lr = ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=3, min_lr=1e-5, verbose=0)\n","\n","    y_train_bins_0idx = (y_train_bins - 1).astype('int32')\n","\n","    print(\"Beginning DINN (widened, softmax) Training...\")\n","    history = model.fit(\n","        [X_mon, X_unc], y_train_bins_0idx,\n","        epochs=epochs, batch_size=batch_size,\n","        verbose=0, validation_split=0.15,\n","        callbacks=[es, reduce_lr]\n","    )\n","    return model, scaler_mon, scaler_unc, history.history\n","\n","\n","def predict_dinn_softmax_bins(model, X_test_matrix, approach, scaler_mon, scaler_unc):\n","    X_mon_test, X_unc_test = split_and_scale_dinn_features(\n","        X_test_matrix, approach, scaler_mon, scaler_unc, is_training=False\n","    )\n","    probs = model.predict([X_mon_test, X_unc_test], verbose=0)\n","    pred_bins_0idx = np.argmax(probs, axis=1)\n","    return pred_bins_0idx + 1"]},{"cell_type":"code","execution_count":106,"metadata":{"executionInfo":{"elapsed":15,"status":"ok","timestamp":1785689038417,"user":{"displayName":"Rahul","userId":"09331106873525786177"},"user_tz":-330},"id":"5K0vS